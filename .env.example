# ==============================================================================
# CRISTI AI COMPANION - ARCHIVO DE CONFIGURACIÓN DE ENTORNO (.env)
# ==============================================================================
# Copia este archivo como .env y rellena las credenciales necesarias.
# Ninguna credencial debe colocarse directamente en el código fuente.

# 1. Google Gemini Multimodal Live API (OBLIGATORIO)
# Obtén tu clave en Google AI Studio: https://aistudio.google.com/
VITE_GEMINI_API_KEY=

# 2. Spotify Web API (OPCIONAL - Para búsqueda y reproducción precisa de canciones)
# Obtén tus credenciales creando una app en: https://developer.spotify.com/dashboard
VITE_SPOTIFY_CLIENT_ID=
VITE_SPOTIFY_CLIENT_SECRET=

# 3. Discord Bot Companion (OPCIONAL - Para acompañamiento autónomo en Discord)
# Obtén tu Bot Token y Client ID en: https://discord.com/developers/applications
VITE_DISCORD_BOT_TOKEN=
VITE_DISCORD_CLIENT_ID=
