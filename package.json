{
  "name": "cristi-ai-companion",
  "version": "1.0.0",
  "description": "Cristi AI Companion",
  "author": "Write_Color",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron:dev": "concurrently \"vite\" \"wait-on http://localhost:5173 && electron electron/main.cjs\"",
    "app:dev": "concurrently \"vite\" \"wait-on http://localhost:5173 && electron electron/main.cjs\"",
    "app:build": "node scripts/prebuild-electron.cjs && vite build && electron-builder --config electron-builder.config.cjs",
    "setup:env": "node scripts/setup-clean-env.cjs",
    "postinstall": "node scripts/postinstall-setup.cjs",
    "test:diagnostics": "node tests/run_all_diagnostics.mjs",
    "test": "node tests/run_all_diagnostics.mjs"
  },
  "dependencies": {
    "@tensorflow-models/coco-ssd": "^2.2.3",
    "@tensorflow/tfjs-backend-webgl": "^4.22.0",
    "@tensorflow/tfjs-converter": "^4.22.0",
    "@tensorflow/tfjs-core": "^4.22.0",
    "@vladmandic/face-api": "^1.7.15",
    "electron-updater": "^6.8.9",
    "lucide-react": "^1.34.0",
    "pixi-live2d-display": "^0.4.0",
    "pixi.js": "^7.4.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.0",
    "concurrently": "^9.2.4",
    "electron": "^32.3.3",
    "electron-builder": "^25.1.8",
    "playwright": "^1.62.1",
    "vite": "^8.2.2",
    "wait-on": "^8.0.5"
  }
}
