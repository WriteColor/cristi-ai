{
  "name": "cristi-ai-companion",
  "version": "1.0.0",
  "description": "Cristi AI Companion",
  "author": "Write_Color",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron:dev": "concurrently \"vite\" \"wait-on http://localhost:5173 && electron electron/main.cjs\"",
    "app:dev": "concurrently \"vite\" \"wait-on http://localhost:5173 && electron electron/main.cjs\"",
    "app:build": "node scripts/prebuild-electron.cjs && vite build && electron-builder --config electron-builder.config.cjs",
    "setup:env": "node scripts/setup-clean-env.cjs",
    "postinstall": "node scripts/postinstall-setup.cjs",
    "test:diagnostics": "node tests/run_all_diagnostics.mjs",
    "test:live-apm": "node scripts/diagnostics/run-live-audit.cjs",
    "test:spark": "node scripts/diagnostics/spark-profiler.cjs",
    "test:live": "node tests/test_live_gemini_master_orchestrator.mjs",
    "test:dual-live": "node tests/test_live_gemini_dual_models_agentic.mjs",
    "test:realtime": "node tests/test_live_gemini_single_session_realtime.mjs",
    "test": "node tests/run_all_diagnostics.mjs"
  },
  "dependencies": {
    "@discordjs/voice": "^0.18.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@tensorflow-models/coco-ssd": "^2.2.3",
    "@tensorflow/tfjs-backend-webgl": "^4.22.0",
    "@tensorflow/tfjs-converter": "^4.22.0",
    "@tensorflow/tfjs-core": "^4.22.0",
    "@vladmandic/face-api": "^1.7.15",
    "discord.js": "^14.27.0",
    "electron-updater": "^6.8.9",
    "lucide-react": "^1.34.0",
    "mineflayer": "^4.38.0",
    "mineflayer-pathfinder": "^2.4.5",
    "opusscript": "^0.1.1",
    "pixi-live2d-display": "^0.4.0",
    "pixi.js": "^7.4.3",
    "prism-media": "^1.3.5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.0",
    "autoprefixer": "^10.5.4",
    "concurrently": "^9.2.4",
    "electron": "^32.3.3",
    "electron-builder": "^25.1.8",
    "eslint": "^10.9.1",
    "playwright": "^1.62.1",
    "postcss": "^8.5.26",
    "tailwindcss": "^4.3.3",
    "vite": "^8.2.2",
    "wait-on": "^8.0.5"
  }
}
