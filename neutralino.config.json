{
  "$schema": "https://raw.githubusercontent.com/neutralinojs/neutralinojs/main/schemas/neutralino.config.schema.json",
  "applicationId": "com.cristiai.app",
  "version": "1.0.0",
  "defaultMode": "window",
  "port": 0,
  "documentRoot": "/dist/",
  "url": "/",
  "enableServer": true,
  "enableNativeAPI": true,
  "logging": {
    "enabled": false
  },
  "nativeBlockList": [],
  "modes": {
    "window": {
      "title": "Cristi AI",
      "width": 1100,
      "height": 850,
      "minWidth": 480,
      "minHeight": 480,
      "fullScreen": false,
      "alwaysOnTop": false,
      "enableInspector": false,
      "borderless": true,
      "transparent": true,
      "maximize": false,
      "hidden": false,
      "resizable": true,
      "exitProcessOnClose": true
    }
  },
  "cli": {
    "binaryName": "cristi-ai",
    "resourcesPath": "/resources/",
    "extensionsPath": "/extensions/",
    "clientLibrary": "/resources/js/neutralino.js",
    "binaryVersion": "5.6.0",
    "clientVersion": "5.6.0"
  }
}
